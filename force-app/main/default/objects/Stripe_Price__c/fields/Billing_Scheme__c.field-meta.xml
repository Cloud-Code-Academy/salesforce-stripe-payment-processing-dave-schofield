<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Billing_Scheme__c</fullName>
    <description>Describes how to compute the price per period. Per unit indicates fixed amount charged per unit. Tiered indicates unit pricing computed using a tiering strategy.</description>
    <label>Billing Scheme</label>
    <required>true</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>per_unit</fullName>
                <default>true</default>
                <label>Per Unit</label>
            </value>
            <value>
                <fullName>tiered</fullName>
                <default>false</default>
                <label>Tiered</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
